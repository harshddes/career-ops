# Local: omit DATABASE_URL to use in-memory PGlite.
# Production: Neon connection string (no credit card on Neon Free).
DATABASE_URL=

# Public site URL for OAuth and magic-link redirects.
APP_BASE_URL=http://127.0.0.1:8787

# Google identity scopes only: openid email profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Without it, magic links are not emailed.
RESEND_API_KEY=
RESEND_FROM=Career OS <onboarding@resend.dev>

# GitHub Action / operator upserts. Never commit the real value.
CATALOG_SERVICE_KEY=

# Local only. Prints the magic-link URL in the login page.
ALLOW_INSECURE_MAGIC_LINK=1

# Seed two demo EURAXESS rows for local UI.
SEED_STUB_CATALOG=1
