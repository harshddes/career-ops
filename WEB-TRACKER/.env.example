# Gmail SMTP for daily digest (WEB-TRACKER)
#
# Setup (one time):
# 1. Copy this file to WEB-TRACKER/.env
# 2. Turn on Google 2-Step Verification for your Gmail account
# 3. Create an App Password: https://myaccount.google.com/apppasswords
#    Choose app "Mail", device "Other" (e.g. Career Ops)
# 4. Paste the 16-character password into SMTP_PASS below (spaces optional)
# 5. Restart the dashboard: node WEB-TRACKER/run.mjs --no-open --mode manual
#
# Never commit WEB-TRACKER/.env — it contains secrets.

DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_TIMEZONE=America/New_York
DAILY_DIGEST_RECIPIENTS=harshddes@gmail.com,desaienggworks@gmail.com,namrataprayaan@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=harshddes@gmail.com
SMTP_PASS=
SMTP_FROM=harshddes@gmail.com
