{
  "name": "web-tracker",
  "version": "1.0.0",
  "description": "Adaptive Fusion Research OS — career intelligence dashboard",
  "type": "module",
  "scripts": {
    "start": "node --experimental-sqlite run.mjs",
    "start:autopilot": "node --experimental-sqlite run.mjs --mode autopilot",
    "start:assisted": "node --experimental-sqlite run.mjs --mode assisted",
    "start:manual": "node --experimental-sqlite run.mjs --mode manual",
    "scan:jobs": "node --experimental-sqlite fusion-scan.mjs --all",
    "scan:phd": "node --experimental-sqlite phd-scan.mjs --all",
    "scan:euraxess": "node --experimental-sqlite euraxess-scan.mjs --all --refresh-liveness",
    "scan:phdscanner": "node --experimental-sqlite phdscanner-scan.mjs --all --refresh-liveness",
    "scan:findaphd": "node --experimental-sqlite findaphd-scan.mjs --all --refresh-liveness",
    "scan:umich": "node --experimental-sqlite umich-careers-scan.mjs --discover",
    "scan:umich:full": "node --experimental-sqlite umich-careers-scan.mjs --full",
    "scan:umich:details": "node --experimental-sqlite umich-careers-scan.mjs --details",
    "scan:umich:rescore": "node --experimental-sqlite umich-careers-scan.mjs --rescore",
    "factory:euraxess": "node --experimental-sqlite euraxess-factory-worker.mjs --max 3",
    "factory:euraxess:dry": "node --experimental-sqlite euraxess-factory-worker.mjs --dry-run --max 3",
    "factory:phdscanner": "node --experimental-sqlite phdscanner-factory-worker.mjs --max 3",
    "factory:phdscanner:dry": "node --experimental-sqlite phdscanner-factory-worker.mjs --dry-run --max 3",
    "backfill:euraxess": "node --experimental-sqlite euraxess-backfill.mjs --profile fusion_plasma_diagnostics --max 500",
    "preflight": "node preflight.mjs --health",
    "control:tick": "node --experimental-sqlite control-plane.mjs --health",
    "control:euraxess-factory": "node --experimental-sqlite control-plane.mjs --health --euraxess-factory",
    "control:phdscanner-factory": "node --experimental-sqlite control-plane.mjs --health --phdscanner-factory",
    "control:autopilot": "node --experimental-sqlite control-plane.mjs --health --autopilot",
    "sync": "node --experimental-sqlite adapters/sync-all.mjs",
    "gate": "node deep-research-gate.mjs",
    "gate:status": "node deep-research-gate.mjs --status",
    "budget:reset": "node deep-research-gate.mjs --reset",
    "install:startup": "powershell -ExecutionPolicy Bypass -File scripts/install-user-startup.ps1 -Mode assisted",
    "install:windows-task": "powershell -ExecutionPolicy Bypass -File scripts/register-windows-task.ps1 -Mode assisted",
    "publish:dashboard": "node lib/generate-static-snapshot.mjs",
    "publish:daemon": "node scripts/publish-daemon.mjs",
    "install:publish-daemon": "powershell -ExecutionPolicy Bypass -File scripts/install-publish-daemon.ps1"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "chokidar": "^4.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "fast-csv": "^5.0.7",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.1"
  }
}
