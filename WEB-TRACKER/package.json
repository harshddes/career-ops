{
  "name": "web-tracker",
  "version": "1.0.0",
  "description": "Adaptive Fusion Research OS — career intelligence dashboard",
  "type": "module",
  "scripts": {
    "start": "node run.mjs",
    "start:autopilot": "node run.mjs --mode autopilot",
    "start:assisted": "node run.mjs --mode assisted",
    "start:manual": "node run.mjs --mode manual",
    "scan:jobs": "node fusion-scan.mjs --all",
    "scan:phd": "node phd-scan.mjs --all",
    "scan:euraxess": "node euraxess-scan.mjs --all --refresh-liveness",
    "scan:phdscanner": "node phdscanner-scan.mjs --all --refresh-liveness",
    "scan:findaphd": "node findaphd-scan.mjs --all --refresh-liveness",
    "factory:euraxess": "node euraxess-factory-worker.mjs --max 3",
    "factory:euraxess:dry": "node euraxess-factory-worker.mjs --dry-run --max 3",
    "factory:phdscanner": "node phdscanner-factory-worker.mjs --max 3",
    "factory:phdscanner:dry": "node phdscanner-factory-worker.mjs --dry-run --max 3",
    "backfill:euraxess": "node euraxess-backfill.mjs --profile fusion_plasma_diagnostics --max 500",
    "preflight": "node preflight.mjs --health",
    "control:tick": "node control-plane.mjs --health",
    "control:euraxess-factory": "node control-plane.mjs --health --euraxess-factory",
    "control:phdscanner-factory": "node control-plane.mjs --health --phdscanner-factory",
    "control:autopilot": "node control-plane.mjs --health --autopilot",
    "sync": "node adapters/sync-all.mjs",
    "gate": "node deep-research-gate.mjs",
    "gate:status": "node deep-research-gate.mjs --status",
    "budget:reset": "node deep-research-gate.mjs --reset",
    "install:startup": "powershell -ExecutionPolicy Bypass -File scripts/install-user-startup.ps1 -Mode assisted",
    "install:windows-task": "powershell -ExecutionPolicy Bypass -File scripts/register-windows-task.ps1 -Mode assisted",
    "publish:dashboard": "node lib/generate-static-snapshot.mjs",
    "publish:daemon": "node scripts/publish-daemon.mjs",
    "install:publish-daemon": "powershell -ExecutionPolicy Bypass -File scripts/install-publish-daemon.ps1"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "fast-csv": "^5.0.7",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.1"
  }
}
